PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# Optional: URL of a self-hosted Traccar server (https://www.traccar.org/) for
# live driver GPS tracking. Leave blank to disable — the driver app simply
# won't report location, and Main Admin's "Live Map" page will show setup
# instructions instead of a map. Point this at your own Traccar instance,
# e.g. http://your-traccar-host:5055 (the OsmAnd protocol port, used for
# reporting) — Main Admin's Live Map iframes the Traccar web UI on port 8082
# by default, so also set TRACCAR_WEB_URL if that differs from TRACCAR_SERVER_URL.
TRACCAR_SERVER_URL=
TRACCAR_WEB_URL=

# Used only the first time you run "npm run seed" to create the admin account
ADMIN_EMAIL=admin@siteguard.de
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Site Admin
