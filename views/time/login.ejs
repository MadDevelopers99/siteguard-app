<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Time Tracking Login — SiteGuard</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin-theme.css">
</head>
<body>
<div class="login-shell sg-admin-v2">
  <div class="login-card">
    <div class="brand"><span class="mark">TT</span> SiteGuard Time Tracking</div>
    <% if (error) { %>
      <div class="error-msg"><%= error %></div>
    <% } %>
    <form method="POST" action="/time/login">
      <div class="form-group" style="margin-bottom:14px;">
        <label>Email</label>
        <input type="email" name="email" required autofocus>
      </div>
      <div class="form-group" style="margin-bottom:20px;">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>
      <button class="btn btn-block" type="submit">Log in</button>
    </form>
    <div class="login-switch">
      No account yet? <a href="/time/register">Create one</a> · <a href="/">Back to site</a>
    </div>
  </div>
</div>
</body>
</html>
