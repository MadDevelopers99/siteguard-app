<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= project.name %> — SiteGuard Time Tracking</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin-theme.css">
</head>
<body>
<div class="admin-shell sg-admin-v2">
  <%- include('../partials/time-sidebar', { active: 'projects', userName: userName, isAdmin: isAdmin }) %>

  <div class="admin-main">
    <div class="admin-topline">
      <h1><%= project.name %></h1>
      <div style="display:flex; gap:12px; align-items:center;">
        <a class="btn btn-outline btn-sm" style="text-decoration:none;" href="/time/projects/<%= project.id %>/edit">Edit</a>
        <a href="/time/projects" style="text-decoration:none; font-size:14px;">&larr; Back to projects</a>
      </div>
    </div>

    <div class="admin-card">
      <h3>Overview</h3>
      <div class="form-grid">
        <div><strong>Customer:</strong> <%= project.client_name %><%= project.client_company ? ' — ' + project.client_company : '' %></div>
        <div><strong>Status:</strong> <span class="badge badge-<%= project.status === 'Active' ? 'confirmed' : project.status === 'Completed' ? 'delivered' : project.status === 'Cancelled' ? 'cancelled' : 'pending' %>"><%= project.status %></span></div>
        <div><strong>Hourly Rate:</strong> <%= project.hourly_rate != null ? '€' + project.hourly_rate.toFixed(2) : '—' %></div>
        <div><strong>Budget:</strong> <%= project.budget_hours != null ? project.budget_hours + ' h' : '—' %></div>
        <div><strong>Logged:</strong> <%= hoursLogged %> h</div>
        <% if (remainingHours != null) { %>
          <div><strong>Remaining:</strong> <span style="<%= remainingHours < 0 ? 'color:var(--danger); font-weight:700;' : '' %>"><%= remainingHours %> h</span></div>
        <% } %>
      </div>
      <% if (project.description) { %>
        <p style="margin-top:14px; color:var(--steel);"><%= project.description %></p>
      <% } %>
    </div>

    <div class="admin-card">
      <h3>Location configuration</h3>
      <p class="muted small" style="margin-top:-6px;">
        Click the map to set the site location. Staff arriving/leaving this radius can auto/prompt start-stop their timer.
        Manage additional geofences for this project on the <a href="/time/geofences?project_id=<%= project.id %>">Geofence Settings</a> screen.
      </p>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>
      <form method="POST" action="/time/projects/<%= project.id %>/geofence">
        <%- include('../partials/time-map', {
          mapId: 'projectLocationMap',
          height: '320px',
          pickMode: true,
          latInputId: 'geofenceLat',
          lngInputId: 'geofenceLng',
          pickInitial: geofence ? [geofence.lat, geofence.lng] : null,
          center: geofence ? [geofence.lat, geofence.lng] : null,
          markers: [],
          geofences: geofence ? [{ lat: geofence.lat, lng: geofence.lng, radiusMeters: geofence.radius_meters, name: geofence.name }] : []
        }) %>
        <input type="hidden" id="geofenceLat" name="lat" value="<%= geofence ? geofence.lat : '' %>">
        <input type="hidden" id="geofenceLng" name="lng" value="<%= geofence ? geofence.lng : '' %>">
        <div class="form-grid" style="margin-top:14px;">
          <div class="form-group"><label>Geofence name</label><input type="text" name="name" value="<%= geofence ? geofence.name : 'Site' %>"></div>
          <div class="form-group"><label>Radius (meters)</label><input type="number" step="10" min="10" name="radius_meters" value="<%= geofence ? geofence.radius_meters : 150 %>"></div>
          <div class="form-group">
            <label>Arrival behavior</label>
            <select name="arrival_behavior">
              <% GEOFENCE_ARRIVAL_OPTIONS.forEach(o => { %>
                <option value="<%= o %>" <%= geofence && geofence.arrival_behavior === o ? 'selected' : '' %>><%= o %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Departure behavior</label>
            <select name="departure_behavior">
              <% GEOFENCE_DEPARTURE_OPTIONS.forEach(o => { %>
                <option value="<%= o %>" <%= geofence && geofence.departure_behavior === o ? 'selected' : '' %>><%= o %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label><input type="checkbox" name="check_in_required" value="1" <%= geofence && geofence.check_in_required ? 'checked' : '' %>> Check-in required</label>
          </div>
        </div>
        <button class="btn btn-sm" type="submit" style="margin-top:10px;">Save location</button>
      </form>
    </div>

    <div class="admin-card">
      <h3>Time Entries</h3>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Date</th><th>Staff</th><th>Service</th><th>Start</th><th>End</th><th>Duration</th><th>Description</th></tr>
          </thead>
          <tbody>
            <% if (entries.length === 0) { %>
              <tr><td colspan="7" style="text-align:center; color:#8a8f90;">No time logged yet.</td></tr>
            <% } %>
            <% entries.forEach(e => { %>
              <tr>
                <td><%= e.date %></td>
                <td><%= e.staff_name || '—' %></td>
                <td><%= e.service_name || '—' %></td>
                <td><%= e.start_time %></td>
                <td><%= e.end_time || 'running…' %></td>
                <td><%= e.duration_minutes != null ? Math.floor(e.duration_minutes / 60) + 'h ' + (e.duration_minutes % 60) + 'm' : '—' %></td>
                <td><%= e.description || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</body>
</html>
