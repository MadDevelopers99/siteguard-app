<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — SiteGuard Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>

  <div class="admin-main">
    <div class="admin-topline">
      <h1>Dashboard</h1>
      <form class="logout-form" method="POST" action="/admin/logout">
        <button type="submit">Log out (<%= adminName %>)</button>
      </form>
    </div>

    <p style="color:var(--steel); margin:-14px 0 20px; font-size:14px;">
      Overall order status and revenue at a glance.
    </p>

    <h3 style="margin-bottom:8px;">Orders</h3>
    <div class="stat-row">
      <div class="stat-card"><span class="num"><%= stats.total_orders || 0 %></span><span class="label">Total Orders</span></div>
      <div class="stat-card"><span class="num"><%= stats.website_orders || 0 %></span><span class="label">Website Orders</span></div>
      <div class="stat-card"><span class="num"><%= stats.email_orders || 0 %></span><span class="label">Email Orders</span></div>
      <div class="stat-card"><span class="num"><%= stats.manual_orders || 0 %></span><span class="label">Manual Orders</span></div>
    </div>
    <div class="stat-row">
      <div class="stat-card"><span class="num"><%= stats.pending_orders || 0 %></span><span class="label">Pending Orders</span></div>
      <div class="stat-card"><span class="num"><%= stats.approval_needed || 0 %></span><span class="label">Approval Needed</span></div>
      <div class="stat-card"><span class="num"><%= stats.confirmed_orders || 0 %></span><span class="label">Confirmed Orders</span></div>
      <div class="stat-card"><span class="num"><%= stats.dispatched_orders || 0 %></span><span class="label">Dispatched to MA</span></div>
    </div>
    <div class="stat-row">
      <div class="stat-card"><span class="num"><%= stats.returned_orders || 0 %></span><span class="label">Returned from MA</span></div>
      <div class="stat-card"><span class="num"><%= stats.delivered_orders || 0 %></span><span class="label">Delivered / Completed</span></div>
      <div class="stat-card"><span class="num"><%= stats.cancelled_orders || 0 %></span><span class="label">Cancelled Orders</span></div>
    </div>

    <h3 style="margin:24px 0 8px;">Revenue</h3>
    <div class="stat-row">
      <div class="stat-card"><span class="num">€<%= (stats.confirmed_value || 0).toFixed(2) %></span><span class="label">Total Confirmed Value</span></div>
      <div class="stat-card"><span class="num">€<%= (stats.delivered_value || 0).toFixed(2) %></span><span class="label">Total Delivered Value</span></div>
      <div class="stat-card"><span class="num">€<%= (stats.revenue_this_month || 0).toFixed(2) %></span><span class="label">Overall Revenue This Month</span></div>
      <div class="stat-card"><span class="num">€<%= (stats.pending_revenue || 0).toFixed(2) %></span><span class="label">Pending Revenue</span></div>
      <div class="stat-card"><span class="num">€<%= (stats.cancelled_value || 0).toFixed(2) %></span><span class="label">Cancelled Value</span></div>
    </div>

    <div class="admin-card">
      <h3>Quick Links</h3>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-sm" style="text-decoration:none;" href="/admin/orders">All Orders</a>
        <a class="btn btn-sm" style="text-decoration:none;" href="/admin/orders?status=approval_needed">Approval Needed</a>
        <a class="btn btn-sm" style="text-decoration:none;" href="/admin/orders?status=pending">Pending</a>
        <a class="btn btn-sm" style="text-decoration:none;" href="/admin/invoices">Invoices</a>
        <a class="btn btn-sm" style="text-decoration:none;" href="/admin/reports">Reports</a>
      </div>
    </div>
  </div>
</div>
</body>
</html>
