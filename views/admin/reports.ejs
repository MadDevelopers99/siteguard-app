<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reports — SiteGuard Admin</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'reports' }) %>

  <div class="admin-main">
    <div class="admin-topline">
      <h1>Reports</h1>
      <form class="logout-form" method="POST" action="/admin/logout">
        <button type="submit">Log out (<%= adminName %>)</button>
      </form>
    </div>

    <div class="admin-card">
      <h3>Orders by Status</h3>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead><tr><th>Status</th><th>Count</th></tr></thead>
          <tbody>
            <% byStatus.forEach(s => { %>
              <tr><td><%= statusLabel(s.status) %></td><td><%= s.n %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="admin-card">
      <h3>Orders by Source</h3>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead><tr><th>Source</th><th>Count</th></tr></thead>
          <tbody>
            <% bySource.forEach(s => { %>
              <tr><td><%= s.source %></td><td><%= s.n %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="admin-card">
      <h3>Revenue by Month (last 12 months, excludes cancelled)</h3>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead><tr><th>Month</th><th>Orders</th><th>Revenue</th></tr></thead>
          <tbody>
            <% if (revenueByMonth.length === 0) { %>
              <tr><td colspan="3" style="text-align:center; color:#8a8f90;">No revenue data yet.</td></tr>
            <% } %>
            <% revenueByMonth.forEach(m => { %>
              <tr><td><%= m.month %></td><td><%= m.n %></td><td>€<%= (m.revenue || 0).toFixed(2) %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</body>
</html>
