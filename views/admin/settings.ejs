<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Settings — SiteGuard Admin</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin-theme.css">
</head>
<body>
<div class="admin-shell office-admin-v2">
  <%- include('../partials/admin-sidebar', { active: 'settings' }) %>

  <div class="admin-main">
    <div class="admin-topline">
      <h1>Settings</h1>
      <form class="logout-form" method="POST" action="/admin/logout">
        <button type="submit">Log out (<%= adminName %>)</button>
      </form>
    </div>

    <% if (success) { %><p style="color:var(--ok);"><%= success %></p><% } %>
    <% if (error) { %><p style="color:var(--danger);"><%= error %></p><% } %>

    <div class="admin-card">
      <h3>My Account</h3>
      <form method="POST" action="/admin/settings" class="form-grid">
        <div class="form-group"><label>Name</label><input type="text" name="name" value="<%= admin.name %>" required></div>
        <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= admin.email %>" required></div>
        <div class="form-group"><label>New Password</label><input type="password" name="password" placeholder="Leave blank to keep current password"></div>
        <div class="form-group"><button class="btn btn-sm" type="submit">Save</button></div>
      </form>
    </div>
  </div>
</div>
</body>
</html>
