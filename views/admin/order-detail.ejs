<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order <%= order.order_number %> — SiteGuard Admin</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin-theme.css">
</head>
<body>
<div class="admin-shell sg-admin-v2">
  <%- include('../partials/admin-sidebar', { active: 'orders' }) %>

  <div class="admin-main">
    <div class="admin-topline">
      <h1>Order <%= order.order_number %></h1>
      <a href="/admin/orders" style="text-decoration:none; font-size:14px;">&larr; Back to orders</a>
    </div>

    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
      <form method="POST" action="/admin/orders/<%= order.id %>/confirm"><button class="btn btn-sm" type="submit">Confirm Order</button></form>
      <form method="POST" action="/admin/orders/<%= order.id %>/send-to-ma"><button class="btn btn-sm" type="submit">Send to MA</button></form>
      <form method="POST" action="/admin/orders/<%= order.id %>/mark-delivered"><button class="btn btn-sm" type="submit">Mark Delivered</button></form>
      <form method="POST" action="/admin/orders/<%= order.id %>/cancel" onsubmit="return confirm('Cancel this order?');"><button class="btn btn-sm" type="submit" style="background:var(--danger); color:#fff;">Cancel Order</button></form>
      <a class="btn btn-sm" style="text-decoration:none;" href="<%= order.request_id ? '/admin/requests/' + order.request_id : '/admin/orders/' + order.id + '/edit' %>">Edit Order</a>
      <a class="btn btn-sm" style="text-decoration:none;" href="/admin/orders/<%= order.id %>/pdf">Download PDF</a>
    </div>

    <div class="admin-card">
      <h3>Client Info</h3>
      <div class="form-grid">
        <div><strong>Name:</strong> <%= order.client_name %></div>
        <div><strong>Company:</strong> <%= order.client_company || '—' %></div>
        <div><strong>Email:</strong> <%= order.client_email || '—' %></div>
        <div><strong>Phone:</strong> <%= order.client_phone || '—' %></div>
        <div><strong>City:</strong> <%= order.client_city || '—' %></div>
        <div><strong>Address:</strong> <%= order.client_address || '—' %></div>
      </div>
    </div>

    <div class="admin-card">
      <h3>Order Details</h3>
      <div class="form-grid">
        <div><strong>Source:</strong> <span class="badge badge-<%= order.source %>"><%= order.source %></span></div>
        <div><strong>Status:</strong> <span class="badge badge-<%= order.status %>"><%= orderStatusLabel(order.status) %></span></div>
        <div><strong>Payment:</strong> <span class="badge badge-<%= (order.payment_status || 'Unpaid').toLowerCase() %>"><%= order.payment_status || 'Unpaid' %></span></div>
        <div><strong>Site address:</strong> <%= order.site_address || '—' %></div>
        <div><strong>Needed by:</strong> <%= order.needed_by || '—' %></div>
        <div><strong>Created:</strong> <%= order.created_at %></div>
        <div><strong>Notes:</strong> <%= order.notes || '—' %></div>
      </div>

      <form method="POST" action="/admin/orders/<%= order.id %>/status" style="margin-top:16px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <label style="margin:0; font-size:13px; font-weight:600;">Update status:</label>
        <select name="status">
          <% ORDER_STATUS_OPTIONS.forEach(s => { %>
            <option value="<%= s.value %>" <%= order.status === s.value ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>
        <button class="btn btn-sm" type="submit">Save</button>
      </form>

      <form method="POST" action="/admin/orders/<%= order.id %>/payment-status" style="margin-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <label style="margin:0; font-size:13px; font-weight:600;">Update payment:</label>
        <select name="payment_status">
          <% ORDER_PAYMENT_STATUS_OPTIONS.forEach(p => { %>
            <option value="<%= p %>" <%= order.payment_status === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
        <button class="btn btn-sm" type="submit">Save</button>
      </form>
    </div>

    <div class="admin-card" id="return">
      <h3>Return / Correction</h3>
      <form method="POST" action="/admin/orders/<%= order.id %>/return" class="form-grid">
        <div>
          <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Reason</label>
          <select name="return_reason" style="width:100%; padding:8px;">
            <option value="">— select —</option>
            <% RETURN_REASONS.forEach(r => { %>
              <option value="<%= r %>" <%= order.return_reason === r ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Note</label>
          <input type="text" name="return_note" value="<%= order.return_note || '' %>" style="width:100%; padding:8px; box-sizing:border-box;">
        </div>
        <div class="full" style="grid-column: 1 / -1;">
          <button class="btn btn-sm" type="submit">Mark as Returned / Needs Correction</button>
        </div>
      </form>
    </div>

    <div class="admin-card">
      <h3>Operations (Main Admin)</h3>
      <div class="form-grid">
        <div><strong>Status:</strong> <span class="badge badge-<%= statusBadgeClass(order.main_admin_status) %>"><%= order.main_admin_status %></span></div>
      </div>
    </div>

    <% if (linkedRequest) { %>
      <div class="admin-card">
        <h3>From Request <a class="order-link" href="/admin/requests/<%= linkedRequest.id %>"><%= linkedRequest.request_number %></a></h3>
        <div class="form-grid">
          <div><strong>Request Type:</strong> <%= linkedRequest.request_type || '—' %></div>
          <div><strong>KVR:</strong> <%= linkedRequest.kvr_required ? linkedRequest.kvr_status : 'Not Required' %></div>
          <div><strong>Absicherung:</strong> <%= linkedRequest.absicherung_required ? linkedRequest.absicherung_type : 'Not Required' %></div>
        </div>
      </div>

      <div class="admin-card">
        <h3>Pricing Breakdown</h3>
        <div class="data-table-wrap">
          <table class="data-table">
            <thead>
              <tr><th>Price Item</th><th>Calculation Type</th><th>Qty</th><th>Unit Price</th><th>Days</th><th>Net Total</th></tr>
            </thead>
            <tbody>
              <% requestPricing.forEach(p => { %>
                <tr>
                  <td><%= p.price_item %></td>
                  <td><%= p.calculation_type %></td>
                  <td><%= p.qty %></td>
                  <td>€<%= p.unit_price.toFixed(2) %></td>
                  <td><%= p.days || '—' %></td>
                  <td>€<%= p.net_total.toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div style="text-align:right; margin-top:14px; font-family: var(--font-mono);">
          <div>Subtotal Net: €<%= (linkedRequest.subtotal_net || 0).toFixed(2) %></div>
          <div>VAT <%= linkedRequest.vat_rate || 19 %>%: €<%= (linkedRequest.vat_amount || 0).toFixed(2) %></div>
          <div style="font-size:20px; font-weight:600;">Total Gross: €<%= order.effective_total.toFixed(2) %></div>
        </div>
      </div>
    <% } else { %>
      <div class="admin-card">
        <h3>Items</h3>
        <div class="data-table-wrap">
          <table class="data-table">
            <thead>
              <tr><th>Item</th><th>Unit Price</th><th>Qty</th><th>Line Total</th></tr>
            </thead>
            <tbody>
              <% lineItems.forEach(li => { %>
                <tr>
                  <td><%= li.item_name %></td>
                  <td>€<%= li.unit_price.toFixed(2) %></td>
                  <td><%= li.quantity %></td>
                  <td>€<%= li.line_total.toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div style="text-align:right; margin-top:14px; font-family: var(--font-mono); font-size:20px; font-weight:600;">
          Total: €<%= order.effective_total.toFixed(2) %>
        </div>
      </div>
    <% } %>
  </div>
</div>
</body>
</html>
