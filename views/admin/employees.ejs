<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Office Employees — SiteGuard Admin</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin-theme.css">
</head>
<body>
<div class="admin-shell office-admin-v2">
  <%- include('../partials/admin-sidebar', { active: 'employees' }) %>

  <div class="admin-main">
    <div class="admin-topline">
      <h1>Office Employees</h1>
      <form class="logout-form" method="POST" action="/admin/logout">
        <button type="submit">Log out (<%= adminName %>)</button>
      </form>
    </div>

    <div class="admin-card">
      <h3>Admin Accounts</h3>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% if (employees.length === 0) { %>
              <tr><td colspan="5" style="text-align:center; color:#8a8f90;">No employees yet.</td></tr>
            <% } %>
            <% employees.forEach(e => { %>
              <tr>
                <td><%= e.name %></td>
                <td><%= e.email %></td>
                <td>
                  <form method="POST" action="/admin/employees/<%= e.id %>/role" style="display:inline;">
                    <select name="role" onchange="this.form.submit()">
                      <% ADMIN_ROLE_OPTIONS.forEach(r => { %>
                        <option value="<%= r %>" <%= e.role === r ? 'selected' : '' %>><%= r %></option>
                      <% }) %>
                    </select>
                  </form>
                </td>
                <td><%= e.created_at %></td>
                <td>
                  <% if (e.id !== adminId) { %>
                    <form method="POST" action="/admin/employees/<%= e.id %>/delete" style="margin:0;" onsubmit="return confirm('Remove this employee?');">
                      <button type="submit" class="btn btn-outline btn-sm">Remove</button>
                    </form>
                  <% } else { %>
                    <span style="color:var(--steel); font-size:12px;">This is you</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="admin-card">
      <h3>+ Add Employee</h3>
      <form method="POST" action="/admin/employees" class="form-grid">
        <div class="form-group"><label>Name</label><input type="text" name="name" required></div>
        <div class="form-group"><label>Email (login)</label><input type="email" name="email" required></div>
        <div class="form-group">
          <label>Role</label>
          <select name="role">
            <% ADMIN_ROLE_OPTIONS.forEach(r => { %><option value="<%= r %>"><%= r %></option><% }) %>
          </select>
        </div>
        <div class="form-group"><label>Password</label><input type="text" name="password" placeholder="Leave blank for ChangeMe123!"></div>
        <div class="form-group"><button class="btn btn-sm" type="submit">+ Add Employee</button></div>
      </form>
    </div>
  </div>
</div>
</body>
</html>
